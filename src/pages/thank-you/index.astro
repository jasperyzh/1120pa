---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Thank You - 1120pa Community Hub">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="text-center py-5">
        <div class="mb-4">
          <span class="display-1">🎉</span>
        </div>
        <h1 class="display-5 mb-3">Thank You!</h1>
        <p class="lead text-muted mb-4">
          Your submission has been received. We appreciate you taking the time to reach out to us.
        </p>
        <div class="alert alert-info">
          <i class="bi bi-clock me-2"></i>
          <strong>What happens next?</strong>
          <p class="mb-0">Our team will review your submission and get back to you within 1-2 business days.</p>
        </div>
        <div class="mt-4">
          <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-2"></i>Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>